# ═══════════════════════════════════════════════════════════════
# Infinite Canvas 商用版 — 环境变量配置
# ═══════════════════════════════════════════════════════════════

# ─── 数据库 ───────────────────────────────────────────────────
# 留空则使用本地 SQLite（开发模式）；填写则使用 PostgreSQL（Supabase 生产）
# Supabase: Project Settings → Database → Connection string
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=
# Supabase 连接可能需要 SSL，设为 false 关闭（本地 PG 不需要）
DATABASE_SSL=true

# ─── 上游 API 配置（你的批发 API） ────────────────────────────
UPSTREAM_BASE_URL=https://api.apib.ai
UPSTREAM_API_KEY=sk-your-upstream-key-here

# ─── 用户认证 ─────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars

# ─── 服务 ─────────────────────────────────────────────────────
PORT=8000
NODE_ENV=production
# 公开访问地址（用于模拟支付页面）
PUBLIC_URL=http://localhost:8000

# ─── CORS 跨域 ────────────────────────────────────────────────
# 逗号分隔的允许域名列表，留空则允许所有（开发模式）
# 生产环境填 Vercel 前端域名，如：https://your-app.vercel.app
CORS_ORIGINS=

# ─── 计费定价（单位：分，1元=100分） ──────────────────────────
PRICE_IMAGE=5
PRICE_VIDEO=50
PRICE_TEXT=1
PRICE_AUDIO=3

# ─── 免费额度（新用户注册赠送，单位：分） ────────────────────
FREE_CREDIT=1000

# ─── 管理员 ───────────────────────────────────────────────────
ADMIN_PASSWORD=admin123

# ─── 支付配置（支付宝） ───────────────────────────────────────
# 留空则使用模拟支付模式
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=

# ─── 支付配置（微信支付） ─────────────────────────────────────
# 留空则使用模拟支付模式
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_NOTIFY_URL=
